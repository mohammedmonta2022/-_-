{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "بيانات حساب المستخدم في مجمع عزم التعليمي",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "اسم المستخدم الفريد"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "البريد الإلكتروني"
        },
        "password": {
          "type": "string",
          "description": "كلمة المرور المشفرة"
        },
        "role": {
          "type": "string",
          "description": "دور المستخدم (مدير النظام أو طالب)"
        },
        "isOfficialSender": {
          "type": "boolean",
          "description": "هل هذا الحساب هو بريد الإرسال المعتمد للنظام"
        },
        "createdAt": {
          "type": "string",
          "description": "تاريخ إنشاء الحساب"
        },
        "isVerified": {
          "type": "boolean",
          "description": "حالة التحقق من البريد"
        }
      },
      "required": ["username", "email", "password", "createdAt"]
    },
    "VerificationCode": {
      "title": "VerificationCode",
      "description": "رمز التحقق المرسل عبر البريد الإلكتروني",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "البريد الإلكتروني المستلم"
        },
        "code": {
          "type": "string",
          "description": "رمز التحقق المكون من 6 أرقام"
        },
        "purpose": {
          "type": "string",
          "enum": ["register", "reset_password"],
          "description": "الغرض من الرمز"
        },
        "createdAt": {
          "type": "string",
          "description": "وقت إنشاء الرمز"
        },
        "expiresAt": {
          "type": "string",
          "description": "وقت انتهاء صلاحية الرمز"
        }
      },
      "required": ["email", "code", "purpose", "createdAt"]
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "إعدادات النظام وتفويض بريد الإرسال المعتمد لمجمع عزم التعليمي",
      "type": "object",
      "properties": {
        "senderEmail": {
          "type": "string",
          "format": "email",
          "description": "البريد الإلكتروني المعتمد لإرسال الإيميلات"
        },
        "senderName": {
          "type": "string",
          "description": "اسم جهة الإرسال (مثال: مجمع عزم التعليمي)"
        },
        "isConfigured": {
          "type": "boolean",
          "description": "هل تم اعتماد وتثبيت بريد الإرسال"
        },
        "isAuthorized": {
          "type": "boolean",
          "description": "هل تم تفويض حساب Google لإرسال الإيميلات"
        },
        "accessToken": {
          "type": "string",
          "description": "رمز التفويض لبريد الإرسال المعتمد في فايربيس"
        },
        "authorizedAt": {
          "type": "string",
          "description": "وقت منح وتخزين تفويض الإرسال"
        },
        "firstUserRegistered": {
          "type": "boolean",
          "description": "هل تم تسجيل أول مستخدم في النظام"
        },
        "configuredAt": {
          "type": "string",
          "description": "وقت وتاريخ اعتماد البريد"
        }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "مجموعة حسابات المستخدمين في مجمع عزم التعليمي"
    },
    "/verification_codes/{codeId}": {
      "schema": "VerificationCode",
      "description": "سجلات رموز التحقق المرسلة للمستخدمين"
    },
    "/system_config/{configId}": {
      "schema": "SystemConfig",
      "description": "إعدادات النظام وتفويض بريد الإرسال الرسمي المحفوظ في فايربيس"
    }
  }
}
